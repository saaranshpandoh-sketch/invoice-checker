# Copy this file to ".env" (same folder) and paste your real key after the = sign.
# The .env file is ignored by git, so your key never gets committed.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Optional: which Gemini model to use (must be on the free tier if you have no billing).
# GEMINI_MODEL=gemini-3.6-flash

# Password that users must enter to use the app (empty = no password).
APP_PASSWORD=
